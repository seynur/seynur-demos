# Splunk MCP Server endpoint — copy from the Splunk MCP Server app settings page.
# Typical Enterprise form: https://<splunk-host>:8089/services/mcp
# From Docker Desktop to a Splunk instance on the host, use host.docker.internal.
SPLUNK_MCP_ENDPOINT=https://splunk.example.com:8089/services/mcp

# Encrypted MCP Bearer token — create in the Splunk MCP Server app (not a regular
# Settings → Tokens API token). Required since MCP Server 1.0.0 / 1.2.x.
# See: https://help.splunk.com/en/splunk-cloud-platform/mcp-server-for-splunk-platform/1.2/connecting-to-the-mcp-server-and-settings
SPLUNK_TOKEN=your_encrypted_mcp_token

# Ollama runs natively on the Mac host. From the n8n container use host.docker.internal.
OLLAMA_BASE_URL=http://host.docker.internal:11434
