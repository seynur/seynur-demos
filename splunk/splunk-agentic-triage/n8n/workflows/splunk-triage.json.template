    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Debug: dump full AI Agent output so we can see intermediateSteps / tool wiring.\nconst item = $input.item.json;\n\nfunction safeStringify(value, space = 2) {\n  const seen = new WeakSet();\n  try {\n    return JSON.stringify(\n      value,\n      (key, val) => {\n        if (typeof val === 'object' && val !== null) {\n          if (seen.has(val)) return '[Circular]';\n          seen.add(val);\n        }\n        if (typeof val === 'bigint') return val.toString();\n        return val;\n      },\n      space,\n    );\n  } catch (e) {\n    return `<<stringify failed: ${e.message}>>`;\n  }\n}\n\nconst keys = Object.keys(item || {});\nconst intermediateSteps =\n  item.intermediateSteps ??\n  item.intermediate_steps ??\n  item.steps ??\n  null;\n\nconst debug = {\n  timestamp: new Date().toISOString(),\n  agent_top_level_keys: keys,\n  has_output: typeof item.output === 'string' || item.output != null,\n  has_text: typeof item.text === 'string',\n  has_intermediateSteps: Array.isArray(item.intermediateSteps),\n  has_intermediate_steps: Array.isArray(item.intermediate_steps),\n  has_steps: Array.isArray(item.steps),\n  intermediateSteps_type: intermediateSteps == null ? 'null' : Array.isArray(intermediateSteps) ? 'array' : typeof intermediateSteps,\n  intermediateSteps_length: Array.isArray(intermediateSteps) ? intermediateSteps.length : null,\n  intermediateSteps_full: intermediateSteps,\n  // Full agent item for deep inspection (may be large)\n  agent_item_full: item,\n};\n\nconst debugJson = safeStringify(debug);\n\nconsole.log('========== [splunk-triage] AI Agent DEBUG START ==========');\nconsole.log('[splunk-triage] agent top-level keys:', keys.join(', '));\nconsole.log('[splunk-triage] intermediateSteps present?', Array.isArray(intermediateSteps), 'length=', Array.isArray(intermediateSteps) ? intermediateSteps.length : 'n/a');\nconsole.log('[splunk-triage] full debug payload:\\n' + debugJson);\nconsole.log('========== [splunk-triage] AI Agent DEBUG END ==========');\n\n// Pass through original agent fields + debug envelope for the webhook response chain\nreturn {\n  json: {\n    ...item,\n    _debug: {\n      agent_top_level_keys: keys,\n      intermediateSteps_type: debug.intermediateSteps_type,\n      intermediateSteps_length: debug.intermediateSteps_length,\n      intermediateSteps_full: intermediateSteps,\n      agent_item_full: item,\n      logged_at: debug.timestamp,\n    },\n  },\n};\n"
      },
      "id": "debug-agent-output",
      "name": "Debug Agent Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        300
      ],
      "notes": "Logs full AI Agent JSON (keys + intermediateSteps) to n8n/docker logs and attaches _debug on the item."
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Diagnose AI Agent + MCP tool usage and parse triage fields.\nconst item = $input.item.json;\nconst upstreamDebug = item._debug || null;\n// Prefer unwrapped agent fields if Debug node spread them\nconst agentItem = upstreamDebug?.agent_item_full || item;\nconst normalized = $('Normalize Payload').item.json;\n\nconst output =\n  typeof agentItem.output === 'string'\n    ? agentItem.output\n    : typeof agentItem.text === 'string'\n      ? agentItem.text\n      : JSON.stringify(agentItem.output ?? agentItem, null, 2);\n\n// Collect intermediate steps from common n8n / LangChain shapes\nlet intermediateSteps = [];\nif (Array.isArray(agentItem.intermediateSteps)) {\n  intermediateSteps = agentItem.intermediateSteps;\n} else if (Array.isArray(agentItem.intermediate_steps)) {\n  intermediateSteps = agentItem.intermediate_steps;\n} else if (Array.isArray(agentItem.steps)) {\n  intermediateSteps = agentItem.steps;\n} else if (Array.isArray(upstreamDebug?.intermediateSteps_full)) {\n  intermediateSteps = upstreamDebug.intermediateSteps_full;\n}\n\nconst toolCalls = [];\nconst toolErrors = [];\n\nfunction asText(value) {\n  if (value == null) return '';\n  if (typeof value === 'string') return value;\n  try {\n    return JSON.stringify(value);\n  } catch (e) {\n    return String(value);\n  }\n}\n\nfunction isHardToolFailure(obsText) {\n  const lower = obsText.toLowerCase();\n  // Only treat clear transport/auth failures as hard errors.\n  // Do NOT match the substring \"error\" alone (false positives in Splunk data).\n  return (\n    lower.includes('could not connect') ||\n    lower.includes('econnrefused') ||\n    lower.includes('enotfound') ||\n    lower.includes('unauthorized') ||\n    lower.includes('forbidden') ||\n    lower.includes('self-signed') ||\n    lower.includes('certificate') ||\n    lower.includes('timed out') ||\n    lower.includes('timeout exceeded') ||\n    lower.includes('mcp error') ||\n    lower.includes('tool failed') ||\n    /^error:/i.test(obsText.trim())\n  );\n}\n\nfor (const step of intermediateSteps) {\n  let action = null;\n  let observation = '';\n\n  // LangChain sometimes stores steps as [action, observation]\n  if (Array.isArray(step) && step.length >= 2) {\n    action = step[0] || {};\n    observation = step[1];\n  } else if (step && typeof step === 'object') {\n    action = step.action || step.toolCall || step;\n    observation = step.observation ?? step.result ?? step.output ?? '';\n  } else {\n    continue;\n  }\n\n  const toolName =\n    action.tool ||\n    action.toolName ||\n    action.name ||\n    action.tool_name ||\n    (action.toolCallId || action.id ? 'unknown_tool' : null);\n\n  const toolInput =\n    action.toolInput ?? action.input ?? action.args ?? action.parameters ?? null;\n\n  const obsText = asText(observation);\n\n  if (toolName) {\n    toolCalls.push({\n      tool: toolName,\n      input: toolInput,\n      observation_preview: obsText.slice(0, 500),\n    });\n  }\n\n  if (toolName && isHardToolFailure(obsText)) {\n    toolErrors.push({\n      tool: toolName,\n      detail: obsText.slice(0, 800) || 'empty observation',\n    });\n  }\n}\n\nconst toolNamesInText =\n  /(?:splunk_)?(?:get_notable_events|search_related_logs|get_risk_score)/i.test(\n    output,\n  );\nconst hasTriageBlock = /TRIAGE\\s*REPORT/i.test(output);\nconst looksLikeRawToolCalls =\n  toolCalls.length === 0 &&\n  ( /Action\\s*:/i.test(output) ||\n    /tool_call/i.test(output) ||\n    (toolNamesInText && !hasTriageBlock) );\n\nfunction extract(sectionRegex) {\n  const m = output.match(sectionRegex);\n  return m && m[1] ? m[1].trim() : '';\n}\n\nconst rootCause = extract(/Root\\s*Cause\\s*:\\s*(.+?)(?:\\n|$)/i);\nconst iocs = extract(/IOCs?\\s*:\\s*([\\s\\S]*?)(?=Recommended\\s+Actions\\s*:|$)/i);\nconst recommendedActions = extract(\n  /Recommended\\s+Actions\\s*:\\s*([\\s\\S]*?)(?=\\n---|\\n*$)/i,\n);\n\nlet mcpStatus = 'unknown';\nconst outputIsEmpty = !String(output || '').trim();\nif (toolCalls.length > 0 && toolErrors.length === 0) {\n  // Tools were actually invoked via the MCP client and did not hard-fail.\n  mcpStatus = 'tools_called_ok';\n} else if (toolCalls.length > 0 && toolErrors.length > 0) {\n  mcpStatus = 'tools_called_with_errors';\n} else if (looksLikeRawToolCalls) {\n  mcpStatus = 'tools_requested_but_not_executed';\n} else if (outputIsEmpty && intermediateSteps.length === 0) {\n  // Model returned empty content. Common when native Ollama streaming drops tool_calls.\n  mcpStatus = 'empty_agent_output';\n} else if (toolCalls.length === 0) {\n  mcpStatus = 'no_tool_calls';\n}\n\nconst parseOk = Boolean(rootCause || iocs || recommendedActions || hasTriageBlock);\n\n// Route to Triage Report when tools ran, or when the model returned a parseable report.\nconst routeOk =\n  mcpStatus === 'tools_called_ok' ||\n  (parseOk && !outputIsEmpty);\n\nconst diagnostics = {\n  mcp_status: mcpStatus,\n  route_ok: routeOk,\n  tool_call_count: toolCalls.length,\n  tool_calls: toolCalls,\n  tool_errors: toolErrors,\n  has_triage_block: hasTriageBlock,\n  parse_ok: parseOk,\n  agent_error: agentItem.error || agentItem.message || null,\n  debug_attached: Boolean(upstreamDebug),\n  agent_top_level_keys: upstreamDebug?.agent_top_level_keys || Object.keys(agentItem || {}),\n  intermediate_steps_present: intermediateSteps.length > 0,\n  intermediate_steps_count: intermediateSteps.length,\n  output_length: output.length,\n  hint:\n    mcpStatus === 'tools_called_ok'\n      ? parseOk\n        ? 'MCP tools invoked successfully and triage fields were parsed.'\n        : 'MCP tools invoked successfully, but the model did not emit a parseable TRIAGE REPORT block. See raw_report.'\n      : mcpStatus === 'tools_requested_but_not_executed'\n        ? 'Model printed tool intents as text; intermediateSteps is empty so MCP tools were not executed.'\n        : mcpStatus === 'empty_agent_output'\n          ? 'Agent returned empty output and no intermediateSteps. Check Ollama load and OpenAI-compat /v1 chat model credentials.'\n          : mcpStatus === 'no_tool_calls' && parseOk\n            ? 'No tool calls recorded, but a parseable TRIAGE REPORT was found in agent output.'\n            : mcpStatus === 'no_tool_calls'\n              ? 'Agent finished without tool calls \u2014 check MCP Client binding and model tool support.'\n              : mcpStatus === 'tools_called_with_errors'\n                ? 'Tools ran but returned transport/auth failures \u2014 inspect tool_errors, endpoint, token, TLS.'\n                : 'Unable to determine MCP tool status.',\n};\n\nconsole.log('[splunk-triage] diagnostics', JSON.stringify(diagnostics, null, 2));\nif (upstreamDebug) {\n  console.log('[splunk-triage] upstream _debug.intermediateSteps_full:', JSON.stringify(upstreamDebug.intermediateSteps_full, null, 2));\n}\n\nreturn {\n  json: {\n    event_id: normalized.event_id || '',\n    severity: normalized.severity || '',\n    src_ip: normalized.src_ip || '',\n    root_cause: rootCause,\n    iocs: iocs,\n    recommended_actions: recommendedActions,\n    raw_report: output,\n    // Top-level flag for reliable IF-node matching (avoid nested boolean quirks)\n    route_ok: routeOk,\n    mcp_status: mcpStatus,\n    diagnostics,\n    _debug: upstreamDebug,\n  },\n};\n"
      },
      "id": "diagnose-mcp",
      "name": "Diagnose MCP & Parse Report",
      "type": "n8n-nodes-base.code",
